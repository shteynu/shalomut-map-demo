# The local environment. Copy to .env and fill in.
#
# The project has two environments and no others: this one and the deployed one
# (Vercel + Render + Supabase). They are wired the same way on purpose, so the
# values below are the local counterparts of the deployed ones rather than a
# looser development set. See docs/local-environment.md.

# Persistence. Locally this is the Postgres container from compose.yaml, which
# `npm run local` starts and migrates on its own.
# Leave both empty to use empty in-memory repositories instead; deployed writes
# without them fail closed.
#
# prisma.config.ts loads .env through dotenv/config, so `prisma migrate` targets
# whatever DATABASE_URL/DIRECT_URL are written here. To migrate the deployed
# database, pass its URL on the command line instead of editing this file —
# a real environment variable outranks the file:
#   DIRECT_URL="postgresql://…supabase…" npx prisma migrate deploy
# Never define a second DATABASE_URL in .env.local: it overrides .env for the
# app but not for migrations, and the two then drift apart. Confirm the host
# Prisma prints before applying any migration.
DATABASE_URL=postgresql://shalomut:shalomut@127.0.0.1:5433/shalomut
DIRECT_URL=postgresql://shalomut:shalomut@127.0.0.1:5433/shalomut

# Core app and AI service integration. `npm run local` starts the AI service on
# 8000 and hands it this same file's secrets.
AI_SERVICE_URL=http://localhost:8000/api/v1/webhook/events
# Trigger gives up after this many ms and answers 504; keep it below the
# platform limit of the /trigger-ai function itself. The webhook answers 202
# straight away, so this bounds the acknowledgement, not the analysis.
AI_SERVICE_TIMEOUT_MS=30000

# Shared secrets between the two halves. Required locally as well: the AI
# service runs with ENV=local, which enforces them exactly like the deployment
# does, and the core app enforces any secret that is set. Generate three
# distinct values — `openssl rand -hex 32` — and never reuse the deployed ones.
MCP_SHARED_SECRET=
AI_WEBHOOK_SECRET=
AI_CALLBACK_SECRET=
# The AI service claims durable Core jobs and renews a 90-second lease while a
# round is running. Core keeps the old webhook endpoint for rollback.
AI_JOB_POLLING_ENABLED=true
AI_JOB_POLL_INTERVAL_SECONDS=2
AI_JOB_HEARTBEAT_INTERVAL_SECONDS=30

# Provider credentials for the AI service, passed through by `npm run local`.
# Without a key every dimension comes back as deterministic fallback: the
# pipeline works, the model is simply never called. Keep the model names equal
# to the deployed ones, or a local run proves nothing about the deployed
# behaviour.
GEMINI_API_KEY=
# Provider requests one round may have in flight; empty means the service
# default of 2, which is what keeps a free tier from meeting the whole batch of
# roughly 33 calls at once. Raise it for a paid key to shorten the round.
LLM_MAX_CONCURRENT_REQUESTS=
# How fast the AI service may reach the provider, in requests per minute; empty
# means the service default of 5, the strictest free tier. Concurrency above
# does not cover this: a round's seventeen requests passed two at a time still
# arrive inside one minute, which is what a free tier answers 429 to. The rate
# belongs to one model, so there are two of them: the first paces LLM_MODEL_FAST
# and the second LLM_MODEL_HEAVY, which a replay switches a whole node to at
# once. Change a rate with the model it names, or the round meets 429 again.
LLM_MAX_REQUESTS_PER_MINUTE=14
LLM_MAX_REQUESTS_PER_MINUTE_HEAVY=4
# Both tiers are gemini-3.5-flash since 2026-08-09. The fast tier was
# gemini-3.5-flash-lite until a full round on the real pipeline showed it
# splicing Arabic letters into Hebrew words; the Hebrew-only gate refused
# fourteen answers and a dimension fell to the deterministic sentence. Same
# round on gemini-3.5-flash: zero refusals. See render.yaml for the numbers.
LLM_MODEL_FAST=gemini-3.5-flash
LLM_MODEL_HEAVY=gemini-3.5-flash

# The ceiling on one dimension's answer. Empty means the service default of
# 2048, and 2048 is not enough for a full round: measured on 2026-08-09 against
# a 24-question round, every call came back `finish_reason=length` with the JSON
# cut mid-object, and all eight stones fell to `deterministic_fallback` while
# the round still reported success. 4096 still truncates and loses one stone;
# 8192 returns eight `llm` stones on the first attempt. The deployment declares
# the same number in `render.yaml`.
MAX_TOKENS_PER_DIMENSION=8192

# Organization every manager session is scoped to. Manager routes resolve the
# scope server-side; a client-supplied scope header is always discarded.
# Required on a deployed runtime, like the two secrets below: a session scoped
# to a missing organization would leave every manager screen silently empty.
# Local development without it falls back to "local-dev-organization".
MANAGER_ORGANIZATION_ID=

# Manager sign-in. Both are required on a deployed runtime: without them
# /api/auth/login answers 503 and no session is ever issued. Locally `next dev`
# accepts the default password `admin123` when MANAGER_ADMIN_PASSWORD is empty;
# set it to sign in the same way you do on the deployment.
#
# On the deployment, generate it — `openssl rand -hex 32`, the same command the
# shared secrets use. Nothing in the code requires this: the check is non-empty
# and `123` would be accepted. It matters because there is one manager account
# per deployment (ADR-020), so an attacker's entire search space is this one
# password, and it is the only thing standing between a public URL and a
# school's answers. Rate limiting slows guessing down; it does not make a weak
# password safe, and a generated one needs no rate limiting at all.
SESSION_SECRET=
MANAGER_ADMIN_EMAIL=
MANAGER_ADMIN_PASSWORD=

# Rate limiting, which counts sign-in attempts and survey submissions per
# client address. It works with none of these set — on one long-lived server
# the counters are correct, and on serverless each instance keeps its own, so
# the real ceiling is the limit times the number of running instances.
#
# Setting both Upstash values moves the counters into Redis, shared by every
# instance, which is the version that actually holds under attack. Nothing
# else changes: no dependency, no flag, no redeploy of anything but the
# environment. Create a database at upstash.com and copy its REST URL and
# token — the REST API is used directly, so no client library is installed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Salt for the hashed address keys. Optional: SESSION_SECRET is used when this
# is empty. Addresses are never stored in the clear — a bucket of plain
# addresses would be a list of who opened the questionnaire and when, which is
# exactly what the consent screen promises does not exist.
RATE_LIMIT_KEY_SALT=

# Analytics contract this environment produces: "3.0", "4.0", "5.0" (unset
# default) or "6.0". The deployed environment explicitly selects "6.0".
# Raise it only after the Python service that accepts the new version is
# confirmed live: the producer is always the last step of a rollout, so a
# rollback never leaves the consumer behind.
#   4.0 carries the school background context into the prompt.
#   5.0 adds the score distribution per question, which changes what the round
#   can say: it lets the interpretation run to five sentences, generates the
#   overall summary with the model instead of a fixed sentence, picks
#   recommendations by the shape of the answers rather than the average, and
#   rewrites the chosen recommendation for the school. Core verifies the
#   distribution it receives back against the analytics it recomputed, so on
#   5.0 the callback rejects a result whose buckets do not match the round.
#   6.0 keeps the numeric evidence and adds structured three-part summaries,
#   narrative question insights and exactly five recommendations per stone.
# Any other value fails the build and the boot rather than falling back: a typo
# used to become "3.0" in silence, so a deployment meant to emit 5.0 emitted the
# oldest contract instead and nothing said so. Empty stays the documented 5.0
# rollback value; use an explicit 6.0 for the current deployed behavior.
# `GET /api/health` reports which version is live and whether it was configured.
AI_ANALYTICS_CONTRACT_VERSION=
