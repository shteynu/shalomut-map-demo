# Optional persistence. Leave both empty to use empty in-memory repositories.
DATABASE_URL=
DIRECT_URL=

# Core app and AI service integration.
AI_SERVICE_URL=http://localhost:8000/api/v1/webhook/events
# Trigger gives up after this many ms and answers 504; keep it below the
# platform limit of the /trigger-ai function itself.
AI_SERVICE_TIMEOUT_MS=30000

# Use distinct high-entropy values outside local development.
MCP_SHARED_SECRET=
AI_WEBHOOK_SECRET=
AI_CALLBACK_SECRET=

# Organization every manager session is scoped to. Manager routes resolve the
# scope server-side; a client-supplied scope header is always discarded.
MANAGER_ORGANIZATION_ID=

# Manager sign-in. Both are required on a deployed runtime: without them
# /api/auth/login answers 503 and no session is ever issued. Local development
# without them runs in an explicit dev mode.
SESSION_SECRET=
MANAGER_ADMIN_EMAIL=
MANAGER_ADMIN_PASSWORD=

# Analytics contract this deployment produces: "3.0" (default) or "4.0".
# Set to 4.0 only after the Python service that accepts 4.0 is confirmed live,
# since 4.0 is what carries the school background context into the prompt.
AI_ANALYTICS_CONTRACT_VERSION=
