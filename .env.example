# Optional persistence. Leave both empty to use empty in-memory repositories.
DATABASE_URL=
DIRECT_URL=

# Core app and AI service integration.
AI_SERVICE_URL=http://localhost:8000/api/v1/webhook/events
# Trigger gives up after this many ms and answers 504; keep it below the
# platform limit of the /trigger-ai function itself.
AI_SERVICE_TIMEOUT_MS=30000

# Use distinct high-entropy values outside local development.
MCP_SHARED_SECRET=
AI_WEBHOOK_SECRET=
AI_CALLBACK_SECRET=

# Shared manager credential bound to exactly one persisted organization.
# Respondent routes and endpoints that verify a machine secret stay outside
# this browser gate. Deployed manager routes fail closed unless all three
# values are configured; local development without them stays open but allows
# at most one persisted organization.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
MANAGER_ORGANIZATION_ID=
