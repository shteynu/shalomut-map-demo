# Optional persistence. Leave both empty to use empty in-memory repositories.
DATABASE_URL=
DIRECT_URL=

# Core app and AI service integration.
APP_BASE_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000/api/v1/webhook/events
# Trigger gives up after this many ms and answers 504; keep it below the
# platform limit of the /trigger-ai function itself.
AI_SERVICE_TIMEOUT_MS=30000

# Use distinct high-entropy values outside local development.
MCP_SHARED_SECRET=
AI_WEBHOOK_SECRET=
AI_CALLBACK_SECRET=

# Shared Basic credential guarding the manager surfaces. It is an access gate,
# not manager identity: it does not scope an organization. Respondent routes and
# the endpoints that verify a shared secret themselves stay reachable without it.
# A deployment that sets neither value serves 503 on manager routes rather than
# opening them; local development without them stays open.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
