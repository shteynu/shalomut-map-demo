{
  "version": "5.0",
  "previousVersions": ["1.0", "2.0", "3.0", "4.0"],
  "breakingChange": "Pass scoreDistribution ({green, yellow, red}) for each question aggregate to Python LLM prompt generation, support 2-5 sentence psychological interpretations, LLM-generated overall summary, and record distribution & cross-dimension context inclusion in provenance.",
  "questionnaire": {
    "sourceOfTruth": "SurveyRound.surveyDefinition",
    "defaultTemplate": "src/lib/shalomut-source.ts",
    "minimumEnabledQuestionsPerDimension": 1,
    "stableQuestionIdsRequired": true,
    "uniqueQuestionIdsRequired": true,
    "explicitDimensionMappingRequired": true,
    "snapshotIdentity": {
      "field": "surveyDefinitionHash",
      "algorithm": "sha256",
      "prefix": "sha256:",
      "projection": ["questionId", "dimensionId", "questionText"],
      "ordering": "questionId ascending by Unicode code point",
      "serialization": "UTF-8 compact JSON array with the projection keys in the documented order, non-ASCII characters unescaped, and no whitespace normalization"
    }
  },
  "backgroundContext": {
    "supportedFields": [
      "notes",
      "audience",
      "sicknessDaysThisQuarter",
      "newStaffMembers",
      "studentCount",
      "socioEconomicIndex",
      "classesPerGrade"
    ],
    "privacyPolicy": "aggregated-school-level-data-only-no-individual-respondent-attributes"
  },
  "privacy": {
    "defaultThreshold": 10,
    "unlockedPolicy": "total-and-every-question-at-or-above-threshold",
    "lockedAggregatePolicy": "empty",
    "partialUnlockedAnalysis": false,
    "providerInvokedWhenLocked": false
  },
  "statuses": [
    {
      "id": "green",
      "minScore": 75,
      "maxScore": 100
    },
    {
      "id": "yellow",
      "minScore": 50,
      "maxScore": 74
    },
    {
      "id": "red",
      "minScore": 0,
      "maxScore": 49
    }
  ],
  "dimensions": [
    {
      "id": "self-expression",
      "nameHebrew": "ביטוי עצמי"
    },
    {
      "id": "professional-competence",
      "nameHebrew": "מסוגלות מקצועית"
    },
    {
      "id": "social-resource",
      "nameHebrew": "קשרים חברתיים"
    },
    {
      "id": "balance",
      "nameHebrew": "איזון"
    },
    {
      "id": "management-support",
      "nameHebrew": "עורף מקצועי"
    },
    {
      "id": "certainty",
      "nameHebrew": "ודאות"
    },
    {
      "id": "organizational-climate",
      "nameHebrew": "אקלים ארגוני"
    },
    {
      "id": "meaning",
      "nameHebrew": "משמעות"
    }
  ],
  "input": {
    "required": [
      "contractVersion",
      "roundId",
      "organizationId",
      "surveyDefinitionHash",
      "dimensionScores",
      "questionAggregates",
      "calculatedAt",
      "totalResponses",
      "privacyThreshold",
      "isLocked"
    ],
    "optional": [
      "backgroundContext"
    ],
    "dimensionScoreCountWhenUnlocked": 8,
    "questionAggregateFields": [
      "questionId",
      "dimensionId",
      "questionText",
      "averageScore",
      "responseCount",
      "scoreDistribution"
    ],
    "scoreDistributionInvariants": {
      "requiredKeys": ["green", "yellow", "red"],
      "nonNegativeIntegersRequired": true,
      "sumMustEqualResponseCount": true,
      "requiredWhenUnlocked": true,
      "forbiddenWhenLocked": true,
      "affectsSurveyDefinitionHash": false
    },
    "forbiddenFields": [
      "respondentId",
      "respondentName",
      "email",
      "anonymousTokenHash",
      "responseId",
      "answers",
      "submittedAt"
    ]
  },
  "output": {
    "stoneCountWhenSuccessful": 8,
    "dynamicMetrics": true,
    "metricCoverage": "exactly every input question aggregate in its persisted dimension",
    "coreOwnedFields": ["score", "status", "dimensionId"],
    "hebrewUserFacingText": true,
    "psychologicalInterpretationSentences": {
      "min": 2,
      "max": 5
    },
    "overallPsychologicalSummary": {
      "generatedByLlm": true,
      "sentencesMin": 2,
      "sentencesMax": 4,
      "language": "Hebrew"
    },
    "singleOverallSummary": true,
    "provenanceFields": [
      "outcome",
      "attempts",
      "retryCount",
      "sourceQuestionIds",
      "surveyDefinitionHash",
      "backgroundContextIncluded",
      "distributionIncluded",
      "crossDimensionContextIncluded"
    ],
    "interventionLookup": "exact-dimension-and-status",
    "interventionAdaptation": {
      "adaptedByLlm": true,
      "adaptedFields": ["summary", "actionable_steps"],
      "preservedFields": ["id", "dimensionId", "status", "source", "title"],
      "stepCountPreserved": true,
      "outcomeField": "adaptationOutcome",
      "outcomes": ["llm", "deterministic_fallback"],
      "language": "Hebrew"
    }
  }
}
