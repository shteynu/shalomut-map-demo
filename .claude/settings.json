{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/gate-hook.mjs",
            "timeout": 90,
            "statusMessage": "Running the gates for this file"
          }
        ]
      }
    ]
  }
}
