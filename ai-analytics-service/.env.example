# Environment Configuration for AI Analytics Microservice
PORT=8000
HOST=0.0.0.0
# Anything other than `development` requires AI_WEBHOOK_SECRET. When ENV and
# VERCEL_ENV are both unset the service assumes `production` and fails closed.
ENV=development

# Data Layer & MCP Configuration
DATA_LAYER_MCP_URL=http://localhost:3000/api/mcp
DATA_LAYER_CALLBACK_URL=http://localhost:3000/api/rounds
USE_MOCK_MCP=true
MCP_SHARED_SECRET=replace_with_shared_mcp_secret
AI_WEBHOOK_SECRET=replace_with_inbound_webhook_secret
AI_CALLBACK_SECRET=replace_with_callback_secret
# Only needed when the core app sits behind Vercel Deployment Protection.
# Value comes from the project's Protection Bypass for Automation secret.
VERCEL_PROTECTION_BYPASS=

# LLM Configuration
# Prefer one provider-specific variable. Its name selects the provider even
# when the key value and model name are opaque:
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here
#
# For a generic/custom credential, set LLM_API_KEY and also set either
# LLM_PROVIDER or LLM_BASE_URL outside development:
# LLM_API_KEY=your_provider_api_key_here
LLM_PROVIDER=auto
LLM_BASE_URL=
LLM_MODEL_FAST=
LLM_MODEL_HEAVY=
# Provider requests one round may have in flight. Both LLM nodes submit their
# whole batch at once, so this is what keeps a free tier from seeing thirty-odd
# requests in one burst. Two matches the strictest free tier; raise it for a
# paid key to shorten the round.
LLM_MAX_CONCURRENT_REQUESTS=2
# Covers the model's thinking as well as its answer; see the service README
# before lowering it.
MAX_TOKENS_PER_DIMENSION=2048
ONLY_LLM_FOR_PROBLEMATIC=true
# Total attempts, including the first request. Retry-After is honored within
# the configured maximum delay; exponential backoff includes jitter.
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_SECONDS=0.5
LLM_RETRY_MAX_DELAY_SECONDS=2.0
LLM_RETRY_JITTER_SECONDS=0.25
# A single request may use up to 20s. The full per-dimension loop is capped at
# 25s and only retries when at least 8s remain for the next attempt.
LLM_REQUEST_TIMEOUT_SECONDS=20.0
LLM_RETRY_BUDGET_SECONDS=25.0
LLM_MIN_RETRY_WINDOW_SECONDS=8.0

# Vector DB Configuration
CHROMA_PERSIST_DIR=./chroma_db
