{
  "openapi": "3.0.3",
  "info": {
    "title": "Shalomut Map API (מפת שלומות)",
    "version": "1.0.0",
    "description": "Clean Data Layer & REST API for Shalomut Map — visualizing school staff wellbeing across 8 organic dimensions. Implements ADR-001 (Raw Data & Privacy Threshold Control)."
  },
  "servers": [
    {
      "url": "https://shalomut-map-demo-ui-redesign.vercel.app",
      "description": "Staging Environment"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "tags": [
    {
      "name": "Rounds",
      "description": "Management of survey rounds and org access codes"
    },
    {
      "name": "Survey",
      "description": "Respondent questionnaire delivery and anonymous response submission"
    },
    {
      "name": "Analytics",
      "description": "Aggregated wellbeing scores and privacy threshold enforcement"
    },
    {
      "name": "AI Integration",
      "description": "MCP transport, AI processing trigger, and versioned Stone Map insights"
    }
  ],
  "paths": {
    "/api/rounds": {
      "get": {
        "tags": ["Rounds"],
        "summary": "Fetch default survey round",
        "description": "Returns details of the default active survey round.",
        "responses": {
          "200": {
            "description": "Successful retrieval of round details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "round": {
                      "$ref": "#/components/schemas/SurveyRound"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Rounds"],
        "summary": "Create new survey round",
        "description": "Generates a new survey round for an organization with a unique share code (SHALOM-XXXX).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRoundInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Survey round created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "round": {
                      "$ref": "#/components/schemas/SurveyRound"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing required fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Failed to create round",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/survey/{shareCode}": {
      "get": {
        "tags": ["Survey"],
        "summary": "Fetch survey questionnaire by share code",
        "description": "Retrieves the survey questionnaire (24 items across 8 wellbeing dimensions) for active survey round.",
        "parameters": [
          {
            "name": "shareCode",
            "in": "path",
            "required": true,
            "description": "Access share code (e.g. SHALOM-DEMO or SHALOM-7492)",
            "schema": {
              "type": "string",
              "example": "SHALOM-DEMO"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Questionnaire metadata and active round details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "round": {
                      "$ref": "#/components/schemas/SurveyRound"
                    },
                    "instrument": {
                      "type": "object",
                      "properties": {
                        "title": { "type": "string", "example": "שאלון שלומות צוות הוראה" },
                        "dimensions": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/WellbeingDimension" }
                        },
                        "questions": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/Question" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Survey round is not active",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Survey code not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Failed to fetch survey",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/survey/{shareCode}/submit": {
      "post": {
        "tags": ["Survey"],
        "summary": "Submit anonymous survey answers",
        "description": "Submits answers for all 24 questions. Preserves participant anonymity strictly.",
        "parameters": [
          {
            "name": "shareCode",
            "in": "path",
            "required": true,
            "description": "Access share code (e.g. SHALOM-DEMO)",
            "schema": {
              "type": "string",
              "example": "SHALOM-DEMO"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["answers"],
                "properties": {
                  "answers": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/QuestionAnswerInput"
                    }
                  },
                  "anonymousTokenHash": {
                    "type": "string",
                    "description": "Optional hash to prevent double submission",
                    "example": "a3f8c9b2e1d0458..."
                  }
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Response recorded successfully",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "success": { "type": "boolean", "example": true },
                      "responseId": { "type": "string", "example": "resp_1721829482910_a83b" }
                    }
                  }
                }
              }
            },
            "400": {
              "description": "Invalid submission or duplicate response",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ErrorResponse"
                  }
                }
              }
            },
            "404": {
              "description": "Survey round not found",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ErrorResponse"
                  }
                }
              }
            },
            "500": {
              "description": "Internal server error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ErrorResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/rounds/{roundId}/analytics": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Fetch aggregated round analytics",
        "description": "Calculates 8 organic wellbeing stone scores (0-100 scale). Enforces privacy threshold (privacyThreshold >= 10). Locks detailed scores if total responses < privacyThreshold.",
        "parameters": [
          {
            "name": "roundId",
            "in": "path",
            "required": true,
            "description": "Unique Survey Round ID (e.g. round_demo_1)",
            "schema": {
              "type": "string",
              "example": "round_demo_1"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Aggregated analytics and dimension scores",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "analytics": {
                      "$ref": "#/components/schemas/RoundAnalyticsResult"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Survey round not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Failed to fetch analytics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp": {
      "post": {
        "tags": ["AI Integration"],
        "summary": "Call the Shalomut MCP endpoint",
        "description": "JSON-RPC 2.0 endpoint exposing tools/list and get_round_analytics through tools/call. Bearer authentication is required when MCP_SHARED_SECRET is configured.",
        "security": [
          { "bearerAuth": [] },
          {}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/McpJsonRpcRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON-RPC request"
          },
          "401": {
            "description": "Missing or invalid configured shared secret"
          },
          "404": {
            "description": "Tool, method, or round not found"
          },
          "500": {
            "description": "MCP server error"
          }
        }
      }
    },
    "/api/rounds/{roundId}/ai-insights": {
      "parameters": [
        {
          "name": "roundId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "example": "round_demo_1"
          }
        }
      ],
      "get": {
        "tags": ["AI Integration"],
        "summary": "Fetch persisted AI insights",
        "responses": {
          "200": {
            "description": "Validated, versioned Stone Map result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoneMapResult"
                }
              }
            }
          },
          "404": {
            "description": "AI insights have not been persisted for this round"
          },
          "500": {
            "description": "Failed to fetch AI insights"
          }
        }
      },
      "post": {
        "tags": ["AI Integration"],
        "summary": "Persist the AI service callback",
        "description": "Validates contract version 1.0, route/payload round identity, privacy semantics, and all eight canonical dimensions before persistence. Bearer authentication is required when AI_CALLBACK_SECRET is configured.",
        "security": [
          { "bearerAuth": [] },
          {}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StoneMapResult"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Insights persisted successfully"
          },
          "400": {
            "description": "Payload violates the AI analytics contract"
          },
          "401": {
            "description": "Missing or invalid configured callback secret"
          },
          "404": {
            "description": "Survey round not found"
          },
          "500": {
            "description": "Failed to persist AI insights"
          }
        }
      }
    },
    "/api/rounds/{roundId}/trigger-ai": {
      "post": {
        "tags": ["AI Integration"],
        "summary": "Request AI processing for a survey round",
        "description": "Forwards a round_closed event to AI_SERVICE_URL. The callback URL is derived from APP_BASE_URL or the incoming request origin. The endpoint fails closed when the AI service is unavailable.",
        "parameters": [
          {
            "name": "roundId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "round_demo_1"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "AI service accepted the event"
          },
          "502": {
            "description": "AI service returned a non-success response"
          },
          "503": {
            "description": "AI service could not be reached"
          },
          "500": {
            "description": "Failed to construct or dispatch the request"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Shared service secret. Required only when the corresponding environment variable is configured."
      }
    },
    "schemas": {
      "RoundStatus": {
        "type": "string",
        "enum": ["draft", "active", "closed", "archived"],
        "example": "active"
      },
      "WellbeingStatus": {
        "type": "string",
        "enum": ["green", "yellow", "red"],
        "example": "green"
      },
      "WellbeingDimensionId": {
        "type": "string",
        "enum": [
          "self-expression",
          "professional-competence",
          "social-resource",
          "balance",
          "management-support",
          "certainty",
          "organizational-climate",
          "meaning"
        ],
        "example": "self-expression"
      },
      "CreateRoundInput": {
        "type": "object",
        "required": ["organizationId", "title"],
        "properties": {
          "organizationId": {
            "type": "string",
            "example": "org_demo_tlv"
          },
          "title": {
            "type": "string",
            "example": "סקר שלומות - מחצית א' תשפ\"ו"
          },
          "privacyThreshold": {
            "type": "integer",
            "default": 10,
            "example": 10
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SurveyRound": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "round_demo_1" },
          "organizationId": { "type": "string", "example": "org_demo_tlv" },
          "title": { "type": "string", "example": "סקר שלומות - מחצית א'" },
          "status": { "$ref": "#/components/schemas/RoundStatus" },
          "shareCode": { "type": "string", "example": "SHALOM-DEMO" },
          "privacyThreshold": { "type": "integer", "example": 10 },
          "startDate": { "type": "string", "format": "date-time" },
          "endDate": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "WellbeingDimension": {
        "type": "object",
        "properties": {
          "id": { "$ref": "#/components/schemas/WellbeingDimensionId" },
          "titleHe": { "type": "string", "example": "ביטוי עצמי" },
          "descriptionHe": { "type": "string", "example": "תחושת חופש להביע דעות ורעיונות" },
          "icon": { "type": "string", "example": "Sparkles" }
        }
      },
      "Question": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "q1" },
          "dimensionId": { "$ref": "#/components/schemas/WellbeingDimensionId" },
          "textHe": { "type": "string", "example": "אני מרגיש/ה שקולי נשמע בבית הספר" }
        }
      },
      "QuestionAnswerInput": {
        "type": "object",
        "required": ["questionId", "dimensionId", "value"],
        "properties": {
          "questionId": { "type": "string", "example": "q1" },
          "dimensionId": { "$ref": "#/components/schemas/WellbeingDimensionId" },
          "value": { "$ref": "#/components/schemas/WellbeingStatus" }
        }
      },
      "RoundDimensionScore": {
        "type": "object",
        "properties": {
          "dimensionId": { "$ref": "#/components/schemas/WellbeingDimensionId" },
          "averageScore": { "type": "number", "example": 84.5 },
          "computedStatus": { "$ref": "#/components/schemas/WellbeingStatus" },
          "totalResponses": { "type": "integer", "example": 18 },
          "isLocked": { "type": "boolean", "example": false },
          "calculatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "RoundAnalyticsResult": {
        "type": "object",
        "properties": {
          "roundId": { "type": "string", "example": "round_demo_1" },
          "totalResponses": { "type": "integer", "example": 18 },
          "privacyThreshold": { "type": "integer", "example": 10 },
          "isLocked": { "type": "boolean", "example": false },
          "dimensionScores": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/RoundDimensionScore"
            }
          },
          "calculatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "McpJsonRpcRequest": {
        "type": "object",
        "required": ["jsonrpc", "id", "method"],
        "properties": {
          "jsonrpc": {
            "type": "string",
            "enum": ["2.0"]
          },
          "id": {
            "oneOf": [
              { "type": "string" },
              { "type": "integer" }
            ]
          },
          "method": {
            "type": "string",
            "enum": ["tools/list", "tools/call"]
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "StoneMetric": {
        "type": "object",
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" },
          "trend": { "type": "string" }
        }
      },
      "StoneIntervention": {
        "type": "object",
        "required": ["id", "dimensionId", "source", "title", "summary", "actionable_steps"],
        "properties": {
          "id": { "type": "string" },
          "dimensionId": { "$ref": "#/components/schemas/WellbeingDimensionId" },
          "source": { "type": "string" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "actionable_steps": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "StoneDetail": {
        "type": "object",
        "required": ["dimensionId", "dimensionNameHebrew", "status", "score", "psychologicalInterpretation", "recommendedInterventions", "metrics"],
        "properties": {
          "dimensionId": { "$ref": "#/components/schemas/WellbeingDimensionId" },
          "dimensionNameHebrew": { "type": "string" },
          "status": { "$ref": "#/components/schemas/WellbeingStatus" },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "psychologicalInterpretation": { "type": "string" },
          "recommendedInterventions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/StoneIntervention" }
          },
          "metrics": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/StoneMetric" }
          }
        }
      },
      "StoneMapResult": {
        "type": "object",
        "required": ["contractVersion", "roundId", "isLocked", "status"],
        "properties": {
          "contractVersion": {
            "type": "string",
            "enum": ["1.0"],
            "example": "1.0"
          },
          "roundId": {
            "type": "string",
            "example": "round_demo_1"
          },
          "processedAt": {
            "type": "string",
            "format": "date-time"
          },
          "isLocked": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": ["success", "locked_error", "validation_failed"]
          },
          "errorMessage": {
            "type": "string"
          },
          "overallPsychologicalSummary": {
            "type": "string"
          },
          "stones": {
            "type": "object",
            "minProperties": 8,
            "maxProperties": 8,
            "additionalProperties": {
              "$ref": "#/components/schemas/StoneDetail"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "Failed to process request" }
        }
      }
    }
  }
}
