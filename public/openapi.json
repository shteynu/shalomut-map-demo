{
  "openapi": "3.0.3",
  "info": {
    "title": "Shalomut Map API (מפת שלומות)",
    "version": "1.0.0",
    "description": "Clean Data Layer & REST API for Shalomut Map — visualizing school staff wellbeing across 8 organic dimensions. Implements ADR-001 (Raw Data & Privacy Threshold Control)."
  },
  "servers": [
    {
      "url": "https://shalomut-map-demo-ui-redesign.vercel.app",
      "description": "Staging Environment"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "tags": [
    {
      "name": "Rounds",
      "description": "Management of survey rounds and org access codes"
    },
    {
      "name": "Manager Setup",
      "description": "Persistence of school, round, and survey-builder configuration"
    },
    {
      "name": "Survey",
      "description": "Respondent questionnaire delivery and anonymous response submission"
    },
    {
      "name": "Analytics",
      "description": "Aggregated wellbeing scores and privacy threshold enforcement"
    },
    {
      "name": "AI Integration",
      "description": "MCP transport, AI processing trigger, and versioned Stone Map insights"
    }
  ],
  "paths": {
    "/api/rounds": {
      "get": {
        "tags": ["Rounds"],
        "summary": "Fetch default survey round",
        "description": "Returns details of the default active survey round.",
        "security": [
          { "basicAuth": [] }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of round details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "round": {
                      "$ref": "#/components/schemas/SurveyRound"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Manager organization scope is required"
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Rounds"],
        "summary": "Create new survey round",
        "description": "Generates a new survey round for an organization with a unique share code (SHALOM-XXXX).",
        "security": [
          { "basicAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRoundInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Survey round created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "round": {
                      "$ref": "#/components/schemas/SurveyRound"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing required fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Organization not found in the manager scope"
          },
          "500": {
            "description": "Failed to create round",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Persistent storage is not configured for this deployment"
          }
        }
      }
    },
    "/api/manager/setup": {
      "put": {
        "tags": ["Manager Setup"],
        "summary": "Create or update manager setup",
        "description": "Persists the school profile, survey round, privacy threshold, dates, and background context. Existing records are updated when their IDs are supplied.",
        "security": [
          { "basicAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManagerSetupInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Manager setup saved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "organization": { "$ref": "#/components/schemas/Organization" },
                    "round": { "$ref": "#/components/schemas/SurveyRound" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid manager setup payload",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Organization or survey round not found in the manager scope"
          },
          "500": {
            "description": "Failed to save manager setup",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "503": {
            "description": "Persistent storage is not configured for this deployment"
          }
        }
      }
    },
    "/api/survey/{shareCode}": {
      "get": {
        "tags": ["Survey"],
        "summary": "Fetch survey questionnaire by share code",
        "description": "Retrieves the survey questionnaire (24 items across 8 wellbeing dimensions) for active survey round.",
        "parameters": [
          {
            "name": "shareCode",
            "in": "path",
            "required": true,
            "description": "Access share code (e.g. SHALOM-7K2M)",
            "schema": {
              "type": "string",
              "example": "SHALOM-7K2M"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Questionnaire metadata and active round details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "round": {
                      "$ref": "#/components/schemas/SurveyRound"
                    },
                    "instrument": {
                      "type": "object",
                      "properties": {
                        "title": { "type": "string", "example": "שאלון שלומות צוות הוראה" },
                        "dimensions": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/WellbeingDimension" }
                        },
                        "questions": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/Question" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Survey round is not active",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Survey code not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Failed to fetch survey",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/survey/{shareCode}/submit": {
      "post": {
        "tags": ["Survey"],
        "summary": "Submit anonymous survey answers",
        "description": "Submits answers for all 24 questions. Preserves participant anonymity strictly.",
        "parameters": [
          {
            "name": "shareCode",
            "in": "path",
            "required": true,
            "description": "Access share code (e.g. SHALOM-7K2M)",
            "schema": {
              "type": "string",
              "example": "SHALOM-7K2M"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["answers"],
                "properties": {
                  "answers": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/QuestionAnswerInput"
                    }
                  },
                  "anonymousTokenHash": {
                    "type": "string",
                    "description": "Optional hash to prevent double submission",
                    "example": "a3f8c9b2e1d0458..."
                  }
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Response recorded successfully",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "success": { "type": "boolean", "example": true },
                      "responseId": { "type": "string", "example": "resp_1721829482910_a83b" }
                    }
                  }
                }
              }
            },
            "400": {
              "description": "Invalid submission or duplicate response",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ErrorResponse"
                  }
                }
              }
            },
            "404": {
              "description": "Survey round not found",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ErrorResponse"
                  }
                }
              }
            },
            "500": {
              "description": "Internal server error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ErrorResponse"
                  }
                }
              }
            },
            "503": {
              "description": "Persistent storage is not configured for this deployment"
            }
          }
        }
      }
    },
    "/api/rounds/{roundId}": {
      "patch": {
        "tags": ["Rounds"],
        "summary": "Transition a survey round status",
        "security": [
          { "basicAuth": [] }
        ],
        "parameters": [
          {
            "name": "roundId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "4f88af95-0ec4-4872-85ac-67466c3cd8f2"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": { "$ref": "#/components/schemas/RoundStatus" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Round status updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "round": { "$ref": "#/components/schemas/SurveyRound" }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid status" },
          "404": { "description": "Survey round not found" },
          "409": { "description": "Status transition is not allowed" },
          "500": { "description": "Failed to update survey round" },
          "503": { "description": "Persistent storage is not configured for this deployment" }
        }
      }
    },
    "/api/rounds/{roundId}/survey-definition": {
      "parameters": [
        {
          "name": "roundId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "example": "4f88af95-0ec4-4872-85ac-67466c3cd8f2"
          }
        }
      ],
      "get": {
        "tags": ["Manager Setup"],
        "summary": "Fetch the saved survey definition",
        "description": "Returns the saved definition or the canonical 24-question definition when the round has not been customized.",
        "security": [
          { "basicAuth": [] }
        ],
        "responses": {
          "200": {
            "description": "Survey definition retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "definition": { "$ref": "#/components/schemas/SurveyDefinition" }
                  }
                }
              }
            }
          },
          "404": { "description": "Survey round not found" }
        }
      },
      "put": {
        "tags": ["Manager Setup"],
        "summary": "Save the survey definition",
        "description": "Persists survey copy and optional questions. The 24 canonical questions must remain enabled, required, unique, and assigned to their canonical dimensions.",
        "security": [
          { "basicAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SurveyDefinition" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Survey definition saved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "definition": { "$ref": "#/components/schemas/SurveyDefinition" }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid survey definition" },
          "404": { "description": "Survey round not found" },
          "500": { "description": "Failed to save survey definition" },
          "503": { "description": "Persistent storage is not configured for this deployment" }
        }
      }
    },
    "/api/rounds/{roundId}/analytics": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Fetch aggregated round analytics",
        "description": "Calculates 8 organic wellbeing stone scores (0-100 scale). Enforces privacy threshold (privacyThreshold >= 10). Locks detailed scores if total responses < privacyThreshold.",
        "security": [
          { "basicAuth": [] }
        ],
        "parameters": [
          {
            "name": "roundId",
            "in": "path",
            "required": true,
            "description": "Unique survey round ID",
            "schema": {
              "type": "string",
              "example": "4f88af95-0ec4-4872-85ac-67466c3cd8f2"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Aggregated analytics and dimension scores",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "analytics": {
                      "$ref": "#/components/schemas/RoundAnalyticsResult"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Survey round not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Failed to fetch analytics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp": {
      "post": {
        "tags": ["AI Integration"],
        "summary": "Call the Shalomut MCP endpoint",
        "description": "JSON-RPC 2.0 endpoint exposing tools/list and get_round_analytics through tools/call. Bearer authentication is required when MCP_SHARED_SECRET is configured.",
        "security": [
          { "bearerAuth": [] },
          {}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/McpJsonRpcRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON-RPC request"
          },
          "401": {
            "description": "Missing or invalid configured shared secret"
          },
          "404": {
            "description": "Tool, method, or round not found"
          },
          "500": {
            "description": "MCP server error"
          }
        }
      }
    },
    "/api/rounds/{roundId}/ai-insights": {
      "parameters": [
        {
          "name": "roundId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "example": "4f88af95-0ec4-4872-85ac-67466c3cd8f2"
          }
        }
      ],
      "get": {
        "tags": ["AI Integration"],
        "summary": "Fetch persisted AI insights",
        "security": [
          { "basicAuth": [] }
        ],
        "responses": {
          "200": {
            "description": "Validated, versioned Stone Map result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoneMapResult"
                }
              }
            }
          },
          "404": {
            "description": "AI insights have not been persisted for this round"
          },
          "500": {
            "description": "Failed to fetch AI insights"
          }
        }
      },
      "post": {
        "tags": ["AI Integration"],
        "summary": "Persist the AI service callback",
        "description": "Validates contract version 1.0, route/payload round identity, privacy semantics, and all eight canonical dimensions before persistence. Bearer authentication is required when AI_CALLBACK_SECRET is configured.",
        "security": [
          { "bearerAuth": [] },
          {}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StoneMapResult"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Insights persisted successfully"
          },
          "400": {
            "description": "Payload violates the AI analytics contract"
          },
          "401": {
            "description": "Missing or invalid configured callback secret"
          },
          "404": {
            "description": "Survey round not found"
          },
          "500": {
            "description": "Failed to persist AI insights"
          },
          "503": {
            "description": "Persistent storage is not configured for this deployment"
          }
        }
      }
    },
    "/api/rounds/{roundId}/trigger-ai": {
      "post": {
        "tags": ["AI Integration"],
        "summary": "Request AI processing for a survey round",
        "description": "Forwards a round_closed event to AI_SERVICE_URL without a dynamic callback target. The AI service derives its callback URL from its trusted DATA_LAYER_CALLBACK_URL configuration and the round ID. The endpoint fails closed when the AI service is unavailable.",
        "security": [
          { "basicAuth": [] }
        ],
        "parameters": [
          {
            "name": "roundId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "4f88af95-0ec4-4872-85ac-67466c3cd8f2"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "AI service accepted the event"
          },
          "404": {
            "description": "Survey round not found in the manager scope"
          },
          "502": {
            "description": "AI service returned a non-success response"
          },
          "503": {
            "description": "AI service could not be reached"
          },
          "500": {
            "description": "Failed to construct or dispatch the request"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Manager credential bound server-side to MANAGER_ORGANIZATION_ID."
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Shared service secret. Required only when the corresponding environment variable is configured."
      }
    },
    "schemas": {
      "RoundStatus": {
        "type": "string",
        "enum": ["draft", "active", "closed", "archived"],
        "example": "active"
      },
      "WellbeingStatus": {
        "type": "string",
        "enum": ["green", "yellow", "red"],
        "example": "green"
      },
      "WellbeingDimensionId": {
        "type": "string",
        "enum": [
          "self-expression",
          "professional-competence",
          "social-resource",
          "balance",
          "management-support",
          "certainty",
          "organizational-climate",
          "meaning"
        ],
        "example": "self-expression"
      },
      "CreateRoundInput": {
        "type": "object",
        "required": ["organizationId", "title"],
        "properties": {
          "organizationId": {
            "type": "string",
            "format": "uuid",
            "example": "c93f8832-8d0d-43cb-b8d2-cdd6e45683af"
          },
          "title": {
            "type": "string",
            "example": "סקר שלומות - מחצית א' תשפ\"ו"
          },
          "privacyThreshold": {
            "type": "integer",
            "default": 10,
            "example": 10
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Organization": {
        "type": "object",
        "required": ["id", "name", "city", "schoolType", "totalStaffCount", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "example": "בית ספר דרור" },
          "city": { "type": "string", "example": "תל אביב" },
          "schoolType": { "type": "string", "example": "ממלכתי" },
          "totalStaffCount": { "type": "integer", "minimum": 1, "example": 34 },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "RoundBackgroundContext": {
        "type": "object",
        "required": [
          "notes",
          "audience",
          "sicknessDaysThisQuarter",
          "newStaffMembers",
          "studentCount",
          "socioEconomicIndex",
          "classesPerGrade"
        ],
        "properties": {
          "notes": { "type": "string" },
          "audience": { "type": "string", "example": "כלל צוות ההוראה" },
          "sicknessDaysThisQuarter": { "type": "integer", "minimum": 0 },
          "newStaffMembers": { "type": "integer", "minimum": 0 },
          "studentCount": { "type": "integer", "minimum": 0 },
          "socioEconomicIndex": { "type": "integer", "minimum": 1, "maximum": 10 },
          "classesPerGrade": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          }
        }
      },
      "ManagerSetupInput": {
        "type": "object",
        "required": ["organization", "round"],
        "properties": {
          "organization": {
            "type": "object",
            "required": ["name", "city", "schoolType", "totalStaffCount"],
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "name": { "type": "string" },
              "city": { "type": "string" },
              "schoolType": { "type": "string" },
              "totalStaffCount": { "type": "integer", "minimum": 1 }
            }
          },
          "round": {
            "type": "object",
            "required": ["title", "privacyThreshold", "startDate", "backgroundContext"],
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "title": { "type": "string" },
              "privacyThreshold": { "type": "integer", "minimum": 10 },
              "startDate": { "type": "string", "format": "date" },
              "endDate": { "type": "string", "format": "date" },
              "backgroundContext": { "$ref": "#/components/schemas/RoundBackgroundContext" }
            }
          }
        }
      },
      "SurveyDefinitionQuestion": {
        "type": "object",
        "required": ["id", "text", "dimensionId", "required", "enabled", "answerMode"],
        "properties": {
          "id": { "type": "string", "example": "q1" },
          "text": { "type": "string" },
          "dimensionId": { "$ref": "#/components/schemas/WellbeingDimensionId" },
          "required": { "type": "boolean" },
          "enabled": { "type": "boolean" },
          "answerMode": { "type": "string", "example": "סקאלת צבעים" }
        }
      },
      "SurveyDefinition": {
        "type": "object",
        "required": [
          "title",
          "audience",
          "estimatedMinutes",
          "minimumResponses",
          "introText",
          "anonymityText",
          "questions"
        ],
        "properties": {
          "title": { "type": "string" },
          "audience": { "type": "string" },
          "estimatedMinutes": { "type": "number", "minimum": 1 },
          "minimumResponses": { "type": "integer", "minimum": 10 },
          "introText": { "type": "string" },
          "anonymityText": { "type": "string" },
          "questions": {
            "type": "array",
            "minItems": 24,
            "items": { "$ref": "#/components/schemas/SurveyDefinitionQuestion" }
          }
        }
      },
      "SurveyRound": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid", "example": "4f88af95-0ec4-4872-85ac-67466c3cd8f2" },
          "organizationId": { "type": "string", "format": "uuid", "example": "c93f8832-8d0d-43cb-b8d2-cdd6e45683af" },
          "title": { "type": "string", "example": "סקר שלומות - מחצית א'" },
          "status": { "$ref": "#/components/schemas/RoundStatus" },
          "shareCode": { "type": "string", "example": "SHALOM-7K2M" },
          "privacyThreshold": { "type": "integer", "example": 10 },
          "startDate": { "type": "string", "format": "date-time" },
          "endDate": { "type": "string", "format": "date-time" },
          "backgroundContext": { "$ref": "#/components/schemas/RoundBackgroundContext" },
          "surveyDefinition": { "$ref": "#/components/schemas/SurveyDefinition" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "WellbeingDimension": {
        "type": "object",
        "properties": {
          "id": { "$ref": "#/components/schemas/WellbeingDimensionId" },
          "titleHe": { "type": "string", "example": "ביטוי עצמי" },
          "descriptionHe": { "type": "string", "example": "תחושת חופש להביע דעות ורעיונות" },
          "icon": { "type": "string", "example": "Sparkles" }
        }
      },
      "Question": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "q1" },
          "dimensionId": { "$ref": "#/components/schemas/WellbeingDimensionId" },
          "textHe": { "type": "string", "example": "אני מרגיש/ה שקולי נשמע בבית הספר" }
        }
      },
      "QuestionAnswerInput": {
        "type": "object",
        "required": ["questionId", "dimensionId", "value"],
        "properties": {
          "questionId": { "type": "string", "example": "q1" },
          "dimensionId": { "$ref": "#/components/schemas/WellbeingDimensionId" },
          "value": { "$ref": "#/components/schemas/WellbeingStatus" }
        }
      },
      "RoundDimensionScore": {
        "type": "object",
        "required": ["dimensionId", "averageScore", "computedStatus", "totalResponses", "isLocked", "calculatedAt"],
        "properties": {
          "dimensionId": { "$ref": "#/components/schemas/WellbeingDimensionId" },
          "averageScore": { "type": "number", "example": 84.5 },
          "computedStatus": { "$ref": "#/components/schemas/WellbeingStatus" },
          "totalResponses": { "type": "integer", "example": 18 },
          "isLocked": { "type": "boolean", "example": false },
          "calculatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "QuestionAggregate": {
        "type": "object",
        "required": ["questionId", "dimensionId", "questionTextHebrew", "averageScore", "responseCount"],
        "properties": {
          "questionId": { "type": "string", "example": "balance-2" },
          "dimensionId": { "$ref": "#/components/schemas/WellbeingDimensionId" },
          "questionTextHebrew": { "type": "string", "example": "יש לי מספיק זמן למנוחה ולהתאוששות אחרי העבודה." },
          "averageScore": { "type": "number", "minimum": 0, "maximum": 100, "example": 40 },
          "responseCount": { "type": "integer", "minimum": 1, "example": 12 }
        }
      },
      "RoundAnalyticsResult": {
        "type": "object",
        "description": "AI analytics input contract 2.0. Privacy-locked rounds return explicit empty dimensionScores and questionAggregates maps.",
        "required": ["contractVersion", "roundId", "totalResponses", "privacyThreshold", "isLocked", "dimensionScores", "questionAggregates", "calculatedAt"],
        "properties": {
          "contractVersion": { "type": "string", "enum": ["2.0"], "example": "2.0" },
          "roundId": { "type": "string", "format": "uuid", "example": "4f88af95-0ec4-4872-85ac-67466c3cd8f2" },
          "totalResponses": { "type": "integer", "example": 18 },
          "privacyThreshold": { "type": "integer", "example": 10 },
          "isLocked": { "type": "boolean", "example": false },
          "dimensionScores": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/RoundDimensionScore"
            }
          },
          "questionAggregates": {
            "type": "object",
            "description": "Exactly 24 canonical aggregates when unlocked; empty when privacy locked.",
            "additionalProperties": {
              "$ref": "#/components/schemas/QuestionAggregate"
            }
          },
          "calculatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "McpJsonRpcRequest": {
        "type": "object",
        "required": ["jsonrpc", "id", "method"],
        "properties": {
          "jsonrpc": {
            "type": "string",
            "enum": ["2.0"]
          },
          "id": {
            "oneOf": [
              { "type": "string" },
              { "type": "integer" }
            ]
          },
          "method": {
            "type": "string",
            "enum": ["tools/list", "tools/call"]
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "StoneMetricV1": {
        "type": "object",
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" },
          "trend": { "type": "string" }
        }
      },
      "StoneInterventionV1": {
        "type": "object",
        "required": ["id", "dimensionId", "source", "title", "summary", "actionable_steps"],
        "properties": {
          "id": { "type": "string" },
          "dimensionId": { "$ref": "#/components/schemas/WellbeingDimensionId" },
          "source": { "type": "string" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "actionable_steps": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "StoneDetailV1": {
        "type": "object",
        "required": ["dimensionId", "dimensionNameHebrew", "status", "score", "psychologicalInterpretation", "recommendedInterventions", "metrics"],
        "properties": {
          "dimensionId": { "$ref": "#/components/schemas/WellbeingDimensionId" },
          "dimensionNameHebrew": { "type": "string" },
          "status": { "$ref": "#/components/schemas/WellbeingStatus" },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "psychologicalInterpretation": { "type": "string" },
          "recommendedInterventions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/StoneInterventionV1" }
          },
          "metrics": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/StoneMetricV1" }
          }
        }
      },
      "StoneMapResultV1": {
        "type": "object",
        "description": "Immutable deployed structural contract 1.0.",
        "required": ["contractVersion", "roundId", "isLocked", "status"],
        "properties": {
          "contractVersion": {
            "type": "string",
            "enum": ["1.0"],
            "example": "1.0"
          },
          "roundId": {
            "type": "string",
            "example": "4f88af95-0ec4-4872-85ac-67466c3cd8f2"
          },
          "processedAt": {
            "type": "string",
            "format": "date-time"
          },
          "isLocked": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": ["success", "locked_error", "validation_failed"]
          },
          "errorMessage": {
            "type": "string"
          },
          "overallPsychologicalSummary": {
            "type": "string"
          },
          "stones": {
            "type": "object",
            "minProperties": 8,
            "maxProperties": 8,
            "additionalProperties": {
              "$ref": "#/components/schemas/StoneDetailV1"
            }
          }
        }
      },
      "StoneMetric": {
        "type": "object",
        "required": ["questionId", "label", "value", "averageScore", "responseCount"],
        "properties": {
          "questionId": { "type": "string", "example": "balance-2" },
          "label": { "type": "string", "example": "יש לי מספיק זמן למנוחה ולהתאוששות אחרי העבודה." },
          "value": { "type": "string", "example": "40 מתוך 100" },
          "averageScore": { "type": "number", "minimum": 0, "maximum": 100, "example": 40 },
          "responseCount": { "type": "integer", "minimum": 1, "example": 12 },
          "trend": { "type": "string" }
        }
      },
      "StoneIntervention": {
        "type": "object",
        "required": ["id", "dimensionId", "status", "source", "title", "summary", "actionable_steps"],
        "properties": {
          "id": { "type": "string" },
          "dimensionId": { "$ref": "#/components/schemas/WellbeingDimensionId" },
          "status": { "$ref": "#/components/schemas/WellbeingStatus" },
          "source": { "type": "string" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "actionable_steps": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      },
      "StoneGenerationProvenance": {
        "type": "object",
        "required": ["outcome", "attempts", "retryCount", "sourceQuestionIds"],
        "properties": {
          "outcome": { "type": "string", "enum": ["llm", "deterministic_fallback"] },
          "attempts": { "type": "integer", "minimum": 0 },
          "retryCount": { "type": "integer", "minimum": 0 },
          "sourceQuestionIds": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "uniqueItems": true,
            "items": { "type": "string" }
          }
        }
      },
      "StoneDetail": {
        "type": "object",
        "required": ["dimensionId", "dimensionNameHebrew", "status", "score", "psychologicalInterpretation", "recommendedInterventions", "metrics", "generationProvenance"],
        "properties": {
          "dimensionId": { "$ref": "#/components/schemas/WellbeingDimensionId" },
          "dimensionNameHebrew": { "type": "string" },
          "status": { "$ref": "#/components/schemas/WellbeingStatus" },
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "psychologicalInterpretation": { "type": "string" },
          "recommendedInterventions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/StoneIntervention" }
          },
          "metrics": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "$ref": "#/components/schemas/StoneMetric" }
          },
          "generationProvenance": { "$ref": "#/components/schemas/StoneGenerationProvenance" }
        }
      },
      "StoneMapResultV2": {
        "type": "object",
        "description": "Breaking semantic contract 2.0. Successful payloads contain exactly eight canonical stones; non-success payloads contain no detailed results.",
        "required": ["contractVersion", "roundId", "isLocked", "status"],
        "properties": {
          "contractVersion": { "type": "string", "enum": ["2.0"], "example": "2.0" },
          "roundId": { "type": "string", "example": "4f88af95-0ec4-4872-85ac-67466c3cd8f2" },
          "processedAt": { "type": "string", "format": "date-time" },
          "isLocked": { "type": "boolean" },
          "status": { "type": "string", "enum": ["success", "locked_error", "validation_failed"] },
          "errorMessage": { "type": "string" },
          "overallPsychologicalSummary": { "type": "string" },
          "stones": {
            "type": "object",
            "minProperties": 8,
            "maxProperties": 8,
            "additionalProperties": { "$ref": "#/components/schemas/StoneDetail" }
          }
        }
      },
      "StoneMapResult": {
        "description": "Consumer-first compatibility union. Consumers accept 1.0 and 2.0; new producers emit 2.0 only after the consumer rollout.",
        "oneOf": [
          { "$ref": "#/components/schemas/StoneMapResultV1" },
          { "$ref": "#/components/schemas/StoneMapResultV2" }
        ],
        "discriminator": {
          "propertyName": "contractVersion",
          "mapping": {
            "1.0": "#/components/schemas/StoneMapResultV1",
            "2.0": "#/components/schemas/StoneMapResultV2"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "Failed to process request" }
        }
      }
    }
  }
}
