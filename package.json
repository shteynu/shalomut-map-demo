{
  "name": "shalomut-map",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "local": "node scripts/local-stack.mjs",
    "build": "prisma generate && next build",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "eslint",
    "test": "node scripts/run-tests.mjs",
    "db:clear": "npx tsx scripts/clear-db.ts",
    "db:seed:local": "npx tsx scripts/seed-local.ts",
    "db:migrate:dev": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:status": "npx prisma migrate status"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "lucide-react": "1.18.0",
    "next": "16.2.9",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@prisma/client": "^7.9.0",
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.9",
    "prisma": "^7.9.0",
    "tailwindcss": "4.3.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.1",
    "lightningcss-linux-x64-gnu": "1.32.0"
  }
}
