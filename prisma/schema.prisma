// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id              String        @id @default(uuid())
  name            String
  city            String
  schoolType      String        @map("school_type")
  totalStaffCount Int           @map("total_staff_count")
  createdAt       DateTime      @default(now()) @map("created_at")
  rounds          SurveyRound[]
  memberships     OrganizationMembership[]

  @@map("organizations")
}

/**
 * A person who signs in.
 *
 * There is no password column and there will not be one: identity comes from an
 * external provider (owner decision, 2026-08-20), so what this row holds is who
 * the address belongs to and what it may reach — never a credential.
 *
 * `isPlatformAdministrator` is a property of the person rather than a
 * membership, which is the whole point of it: an administrator is outside the
 * membership system instead of being a member of every school, so the number of
 * schools never changes what their session carries.
 */
model Manager {
  id                      String   @id @default(uuid())
  /// Lowercased before it is stored. The provider decides the case of what it
  /// returns and a second sign-in must not create a second person.
  email                   String   @unique
  name                    String
  isPlatformAdministrator Boolean  @default(false) @map("is_platform_administrator")
  createdAt               DateTime @default(now()) @map("created_at")

  memberships OrganizationMembership[]

  @@map("managers")
}

/**
 * What one person may reach in one school.
 *
 * Many-to-many even though the product gives a school user exactly one school:
 * the types and the session token already carry a list, the product is what
 * constrains it to one, and nothing has to be migrated the day that constraint
 * is relaxed.
 */
model OrganizationMembership {
  id             String   @id @default(uuid())
  managerId      String   @map("manager_id")
  organizationId String   @map("organization_id")
  role           String   // 'admin' | 'manager'
  status         String   // 'active' | 'invited' | 'suspended'
  createdAt      DateTime @default(now()) @map("created_at")

  manager      Manager      @relation(fields: [managerId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // One person is a member of one school once. Two rows would be two answers to
  // "what may they do here", and the session reads whichever came back first.
  @@unique([managerId, organizationId])
  @@index([organizationId])
  @@map("organization_memberships")
}

model SurveyRound {
  id                  String           @id @default(uuid())
  organizationId      String           @map("organization_id")
  title               String
  status              String           // 'draft' | 'active' | 'closed' | 'archived'
  shareCode           String           @unique @map("share_code")
  privacyThreshold    Int              @default(10) @map("privacy_threshold")
  startDate           DateTime         @default(now()) @map("start_date")
  endDate             DateTime?        @map("end_date")
  backgroundContext   Json?            @map("background_context")
  surveyDefinition    Json?            @map("survey_definition")
  createdAt           DateTime         @default(now()) @map("created_at")
  // When the round last reached the database. Nullable on purpose: rounds that
  // predate the column have no honest value, and the screens would rather show
  // no time than one they made up.
  updatedAt           DateTime?        @updatedAt @map("updated_at")
  aiInsights          Json?            @map("ai_insights")
  aiInsightsUpdatedAt DateTime?        @map("ai_insights_updated_at")

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  responses           SurveyResponse[]
  attempts            SurveyAttempt[]
  aiAnalysisRuns      AiAnalysisRun[]
  goals               RoundGoal[]
  definitionVersions  SurveyDefinitionVersion[]

  // A school runs one round at a time, enforced by the partial unique index
  // `survey_rounds_one_active_per_organization` on `(organization_id) where
  // status = 'active'`. Prisma cannot express a partial index here, so it is
  // owned by migration `20260804120000_one_active_round_per_organization` and
  // changed by writing another migration rather than by editing this model.
  @@map("survey_rounds")
}

/**
 * A recommendation a manager decided to work on.
 *
 * The title and body are copied here at the moment of the decision rather than
 * referenced. A recommendation belongs to the analysis and is rewritten by the
 * next run; a goal belongs to the school and must outlive it, otherwise
 * "tracked" means nothing. That copy is also why there is no foreign key into
 * the AI result: the goal is complete on its own.
 */
model RoundGoal {
  id          String   @id @default(uuid())
  roundId     String   @map("round_id")
  dimensionId String   @map("dimension_id")
  title       String
  body        String
  status      String   // 'selected' | 'in_progress' | 'done'
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  round SurveyRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  // One recommendation becomes one goal. The service checks before inserting,
  // which a double-tapped button passes twice; only the database can refuse
  // atomically. The title is the recommendation's identity — the payload
  // carries no id of its own.
  @@unique([roundId, dimensionId, title])
  @@index([roundId, createdAt])
  @@map("round_goals")
}

model SurveyDefinitionVersion {
  id         String   @id @default(uuid())
  roundId    String   @map("round_id")
  definition Json
  savedAt    DateTime @default(now()) @map("saved_at")

  round SurveyRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  // The list is read per round, newest first, and pruning reads the same order.
  @@index([roundId, savedAt])
  @@map("survey_definition_versions")
}

model AiAnalysisRun {
  id                 String      @id @default(uuid())
  sequence           Int         @unique @default(autoincrement())
  roundId            String      @map("round_id")
  requestKey         String      @map("request_key")
  trigger            String
  state              String
  attemptCount       Int         @default(0) @map("attempt_count")
  queuedAt           DateTime    @default(now()) @map("queued_at")
  startedAt          DateTime?   @map("started_at")
  heartbeatAt        DateTime?   @map("heartbeat_at")
  leaseExpiresAt     DateTime?   @map("lease_expires_at")
  leaseToken         String?     @map("lease_token")
  workerId           String?     @map("worker_id")
  completedAt        DateTime?   @map("completed_at")
  callbackReceivedAt DateTime?   @map("callback_received_at")
  failureCode        String?     @map("failure_code")
  result             Json?

  /// Which dimensions this run has to write again. Empty is the ordinary
  /// case and means the whole round: a run that names nothing regenerates
  /// everything, so every row written before this column existed keeps its
  /// meaning without a backfill.
  regenerateDimensionIds String[] @default([]) @map("regenerate_dimension_ids")

  round SurveyRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, requestKey])
  @@index([state, leaseExpiresAt, queuedAt])
  @@index([roundId, queuedAt])
  @@map("ai_analysis_runs")
}

model SurveyResponse {
  id                 String           @id @default(uuid())
  roundId            String           @map("round_id")
  anonymousTokenHash String?          @map("anonymous_token_hash")
  submittedAt        DateTime         @default(now()) @map("submitted_at")
  // Whole seconds the questionnaire was visible to this respondent, summed by
  // their own browser and sent once with the answers. One number and never a
  // per-step or per-question breakdown: the round reports how long filling
  // took, and a finer series would describe how someone thought about a
  // particular statement.
  //
  // Null is the ordinary case, not a defect. A response stored before this
  // existed has none, a browser that fired no visibility event sends none, and
  // a draft resumed without its accumulated total deliberately sends none
  // rather than a figure that would undercount. The round's report counts these
  // apart and falls back to the session's own clock; it never reads a missing
  // measurement as a fast one.
  visibleSeconds     Int?             @map("visible_seconds")

  round              SurveyRound      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  answers            QuestionAnswer[]

  // One filling session, one response. The service checked this before
  // inserting, which two parallel requests both pass; only the database can
  // refuse atomically. PostgreSQL treats NULLs as distinct, so a submission
  // that carries no token is unaffected — it has no session to deduplicate.
  @@unique([roundId, anonymousTokenHash])
  @@index([roundId, submittedAt])
  @@map("survey_responses")
}

/**
 * One filling session's progress through the questionnaire.
 *
 * Until this table existed, `SurveyResponse` was the only respondent-side row
 * and it was written solely on a successful submit — so a teacher who opened
 * the link and left was byte-for-byte identical to one who never received it.
 * Those are two failures with opposite fixes, and response rate is the number
 * that decides whether a school ever sees anything at all.
 *
 * It holds no more identity than `SurveyResponse` does: the same hash of the
 * same per-attempt token, which lives in the respondent's own sessionStorage,
 * is reset between people at a shared computer, and is not a device or a
 * person. No IP and no user agent. What it adds over the response row is the
 * attempts that never became one.
 *
 * This table's own timing is still the round's clock and nothing finer — when
 * the session opened, consented and finished. Since 2026-08-17 the *response*
 * row carries one more figure, `visibleSeconds`, which its own comment
 * describes; it is a total for the whole questionnaire and there is still no
 * per-step or per-question timing anywhere in this schema.
 */
model SurveyAttempt {
  id                  String      @id @default(uuid())
  roundId             String      @map("round_id")
  anonymousTokenHash  String      @map("anonymous_token_hash")
  openedAt            DateTime    @default(now()) @map("opened_at")
  consentAcceptedAt   DateTime?   @map("consent_accepted_at")
  // Zero-based index of the furthest question the respondent reached, which is
  // where the drop-off sits. Null until they accept and see the first one.
  lastQuestionReached Int?        @map("last_question_reached")
  completedAt         DateTime?   @map("completed_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  round               SurveyRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  // One filling session, one row. The endpoint is public and unauthenticated,
  // so the upsert key is what keeps a reload from reading as a second teacher.
  @@unique([roundId, anonymousTokenHash])
  @@index([roundId, openedAt])
  @@map("survey_attempts")
}

model QuestionAnswer {
  id          String         @id @default(uuid())
  responseId  String         @map("response_id")
  questionId  String         @map("question_id")
  // Null for a background answer, which belongs to no wellbeing dimension.
  // Every row written before background questions existed carries one.
  dimensionId String?        @map("dimension_id")
  // Whatever the question's own scale or option set allows: a colour
  // ('green'), a Likert step ('4'), a chosen option ('high-school') or an
  // allocation entry ('25').
  value       String
  // 0-100 under positive polarity, complemented for a negative one. Null for a
  // background answer: it is stored and counted and contributes to no average,
  // which is not the same as contributing zero.
  score       Int?

  response    SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  // A response answers each question once. Aggregates average over these rows,
  // so a duplicate would silently reweight a dimension rather than fail.
  @@unique([responseId, questionId])
  @@index([responseId])
  @@map("question_answers")
}
